{
  "name": "bdos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "next build",
    "db:apply": "./db/apply.sh bdos_dev",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:test": "./db/test.sh",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 0.0.0.0",
    "test": "tsx --test packages/*/test/*.test.ts",
    "test:e2e": "playwright test",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:ledger": "tsx --test packages/ledger/test/*.test.ts",
    "test:money": "tsx --test packages/money/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run db:test"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}

# Copy to .env.local. A fresh database is required for the first migration.
DATABASE_URL=postgresql://bdos:bdos_local@localhost:5433/bdos_mvp
APP_ORIGIN=http://localhost:3000
# Explicit sandbox: simulated OTP, payments, couriers and payouts. No real money.
BDOS_SANDBOX=true
# Optional path to ffmpeg; required for uploaded video transcoding.
FFMPEG_PATH=bundled
MEDIA_DIR=.data/media

# Outside sandbox: required 32+ character secret and HTTPS origin.
# AUTH_SECRET=
# SMS_WEBHOOK_URL=https://your-sms-adapter.example/send
# SMS_WEBHOOK_TOKEN=

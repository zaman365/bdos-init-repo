{
  "$schema": "https://design-tokens.org/schema.json",
  "brand": {
    "delta":     { "value": "#00E37A", "reservedFor": "primary action, brand, focus" },
    "deltaDeep": { "value": "#00A85B", "reservedFor": "green on light grounds, pressed states" },
    "sonar":     { "value": "#FFC24B", "reservedFor": "money: earnings, commission, gifts, rewards" },
    "padma":     { "value": "#FF3B4E", "reservedFor": "LIVE indicator only" },
    "kalo":      { "value": "#0A0C0B", "reservedFor": "ground" },
    "shapla":    { "value": "#F2F5F0", "reservedFor": "light ground, text on dark" }
  },
  "neutral": {
    "900": "#0A0C0B", "800": "#121614", "700": "#1B211E",
    "500": "#4A5A53", "300": "#8A9A92", "100": "#D8E0DB"
  },
  "type": {
    "display": "Anek Latin / Anek Bangla 700-800, condensed-to-normal width",
    "text": "Anek Latin / Anek Bangla 400-600",
    "data": "IBM Plex Mono",
    "fallback": "Noto Sans Bengali, sans-serif",
    "numerals": "tabular; Bengali numerals follow language setting, currency always tabular"
  },
  "motif": { "matra": { "weight": "3px", "nib": "64px", "position": "above the element, drawn left-to-right" } }
}
